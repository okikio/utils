{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices"
	],
	"dependencyDashboard": {
		"enabled": true
	},
	"minimumReleaseAge": "3 days",
	"internalChecksFilter": "strict",
	"rangeStrategy": "bump",
	"prConcurrentLimit": 5,
	"schedule": [
		"before 6am on monday"
	],
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": [
			"before 6am on monday"
		]
	},
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": [
			"security"
		],
		"minimumReleaseAge": null,
		"schedule": [
			"at any time"
		]
	},
	"osvVulnerabilityAlerts": true,
	"packageRules": [
		{
			"description": "One PR a week for every minor and patch update.",
			"matchUpdateTypes": [
				"minor",
				"patch",
				"digest",
				"pin",
				"pinDigest"
			],
			"groupName": "non-major updates"
		},
		{
			"description": "Runtimes and tools in mise.toml and packageManager move together.",
			"matchDepNames": [
				"deno",
				"node",
				"bun",
				"pnpm",
				"jdx/mise"
			],
			"groupName": "runtimes"
		},
		{
			"description": "The tools read the TypeScript 6 compiler API. TypeScript 7.0 has no API; `typescript-native` carries 7.x for tsc.",
			"matchDepNames": [
				"typescript"
			],
			"allowedVersions": "<7"
		},
		{
			"description": "OpenTelemetry packages share one release train.",
			"matchPackageNames": [
				"@opentelemetry/**"
			],
			"groupName": "opentelemetry"
		},
		{
			"description": "LogTape packages release together.",
			"matchPackageNames": [
				"@logtape/**"
			],
			"groupName": "logtape"
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"description": "mise version bootstrapped by jdx/mise-action and required by mise.toml.",
			"managerFilePatterns": [
				"/^\\.github/workflows/.+\\.ya?ml$/",
				"/^mise\\.toml$/"
			],
			"matchStrings": [
				"uses: jdx/mise-action@\\S+.*\\n\\s+with:\\n\\s+version: (?<currentValue>\\d+\\.\\d+\\.\\d+)",
				"min_version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
			],
			"depNameTemplate": "jdx/mise",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^v(?<version>.+)$"
		},
		{
			"customType": "regex",
			"description": "Rust toolchain that builds the hash WebAssembly modules. A bump needs `tools/packages/wasm.ts --write`.",
			"managerFilePatterns": [
				"/(^|/)rust-toolchain\\.toml$/"
			],
			"matchStrings": [
				"channel = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
			],
			"depNameTemplate": "rust",
			"packageNameTemplate": "rust-lang/rust",
			"datasourceTemplate": "github-releases"
		}
	]
}
