{
	"baseBranch": "main",
	"access": "public",
	"changelog": "default",
	"privatePackages": {
		"version": true,
		"tag": false
	},
	"packages": {
		"@okikio/*": {
			"publishCommand": "deno run --allow-read --allow-net=jsr.io --allow-run ../../.bumpy/release.ts publish",
			"skipNpmPublish": true,
			"cascadeTo": {
				"@okikio/utils": {
					"trigger": "patch",
					"bumpAs": "match"
				}
			},
			"checkPublished": "deno run --allow-read --allow-net=jsr.io ../../.bumpy/release.ts published"
		},
		"@okikio/utils": {
			"publishCommand": "deno run --allow-read --allow-net=jsr.io --allow-run ../../.bumpy/release.ts publish",
			"skipNpmPublish": true,
			"checkPublished": "deno run --allow-read --allow-net=jsr.io ../../.bumpy/release.ts published"
		}
	},
	"versionPr": {
		"title": "🐸 Version @okikio/utils packages",
		"branch": "bumpy/version-packages",
		"preamble": "This release PR is generated from `.bumpy/*.md`. It updates package versions and changelogs. The workflow then synchronizes the same versions into each JSR `deno.json[c]` manifest before the release commit is finalized."
	}
}
