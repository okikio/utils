{
	"nodeModulesDir": "manual",
	"workspace": [
		"packages/*",
		"examples/*",
		"tools"
	],
	"tasks": {
		"fmt": "mise run check:format",
		"lint": "mise run check:lint",
		"check": "mise run check",
		"test": "mise run test",
		"test:docs": "mise run test:docs"
	},
	"test": {
		"exclude": [
			"tests/workflows/",
			"packages/storage/queue/postgres.test.ts",
			"packages/storage/state/postgres.test.ts"
		]
	},
	"exports": {},
	"imports": {
		"#tools/": "./tools/",
		"#fixtures/": "./tests/fixtures/",
		"#bench/": "./bench/",
		"elysia/": "npm:elysia@1.4.30/",
		"@okikio/observables": "jsr:@okikio/observables@^1.4.0",
		"@std/async": "jsr:@std/async@^1.5.1",
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/xml": "jsr:@std/xml@^0.2.0"
	},
	"compilerOptions": {
		"lib": [
			"deno.window",
			"dom",
			"dom.iterable"
		],
		"types": [
			"npm:@types/node"
		],
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true
	},
	"fmt": {
		// Markdown keeps authored wrapping and code-block layout; review its meaning and examples separately.
		// Generated evidence and archived research retain exact source provenance.
		"exclude": [
			// Entire manages its settings and the Codex hooks it installs.
			".codex/hooks.json",
			".entire/settings.json",
			// Copied guidance keeps its upstream formatting; local agent files retain this repository's rules.
			".agents/START.md",
			".agents/GUIDANCE.md",
			".agents/guides/**",
			".agents/references/**",
			".agents/skills/**",
			".agents/handbook/**",
			"pnpm-lock.yaml",
			"**/*.md",
			// Hidden project profiles follow the same authored Markdown wrapping rule.
			".agents/README.md",
			".sampo/changesets/*.md",
			"**/.example-*/**",
			".tmp/artifacts/**",
			".tmp/**",
			".tmp/docs/design/**",
			".tmp/docs/history/**"
		],
		"lineWidth": 120,
		"semiColons": true,
		"singleQuote": true,
		"useTabs": true,
		"indentWidth": 2
	},
	"lint": {
		"exclude": [
			".tmp/**",
			"**/.example-*/**",
			// Upstream owns these guidance examples; local agent programs remain subject to lint.
			".agents/guides/**",
			".agents/references/**",
			".agents/skills/**",
			".agents/handbook/**"
		],
		"rules": {
			"tags": [
				"recommended"
			],
			"exclude": [
				"no-slow-types",
				"require-await"
			]
		}
	},
	"allowScripts": {}
}
