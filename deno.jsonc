{
	"nodeModulesDir": "manual",
	"workspace": [
		"packages/*",
		"examples/*"
	],
	"tasks": {
		"fmt": "mise run check -- --kind format",
		"lint": "mise run check -- --kind lint",
		"check": "mise run check",
		"test": "mise run test",
		"test:docs": "mise run test -- --suite docs"
	},
	"test": {
		"exclude": [
			"tests/workflows/",
			"packages/storage/queue/postgres.test.ts",
			"packages/storage/state/postgres.test.ts"
		]
	},
	"exports": {},
	"imports": {
		"#tools/": "./tools/",
		"#fixtures/": "./tests/fixtures/",
		"#bench/": "./bench/",
		"elysia/": "npm:elysia@1.4.30/",
		"@okikio/observables": "jsr:@okikio/observables@^1.4.0",
		"@std/async": "jsr:@std/async@^1.5.0",
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/xml": "jsr:@std/xml@^0.2.0"
	},
	"compilerOptions": {
		"lib": [
			"deno.window",
			"dom",
			"dom.iterable"
		],
		"types": [
			"npm:@types/node"
		],
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true
	},
	"fmt": {
		// Markdown keeps authored wrapping and code-block layout; review its meaning and examples separately.
		// Generated evidence and archived research retain exact source provenance.
		"exclude": [
			"pnpm-lock.yaml",
			"**/*.md",
			".bumpy/*.md",
			"**/.example-*/**",
			".tmp/artifacts/**",
			".tmp/**",
			".tmp/docs/design/**",
			".tmp/docs/history/**"
		],
		"lineWidth": 120,
		"semiColons": true,
		"singleQuote": true,
		"useTabs": true,
		"indentWidth": 2
	},
	"lint": {
		"exclude": [".tmp/**", "**/.example-*/**"],
		"rules": {
			"tags": [
				"recommended"
			],
			"exclude": [
				"no-slow-types",
				"require-await"
			]
		}
	},
	"allowScripts": {}
}
