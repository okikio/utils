{
	"name": "@okikio/context",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./state": "./state.ts",
		"./events": "./events.ts",
		"./testing": "./testing.ts"
	},
	"imports": {
		"@std/async": "jsr:@std/async@^1.5.0"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project context",
		"test": "mise run test -- --project context",
		"bench": "mise run bench -- --project context",
		"bench:check": "mise run bench -- --project context --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
