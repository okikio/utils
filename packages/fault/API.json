		"@okikio/fault": {
			"module_doc": {
				"doc": "Project unexpected errors into bounded diagnostics without retaining the live object or invoking user getters. JSON.stringify(Error) usually drops the message; arbitrary coercion can execute application code.\n\nUse encode() for Worker fault frames or structured telemetry, and message() for a bounded display string. Choose explicit depth, entry and string limits for untrusted objects. Native inherited error names survive projection; accessor-backed properties become markers. Stack inclusion defaults to true and can be disabled and custom stack formatting is excluded. Bounded output still needs application-specific redaction.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport * as fault from '@okikio/fault';\nconst error = new TypeError('Provider returned an invalid value.');\nconsole.log(JSON.stringify(fault.encode(error, { includeStack: false })));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
