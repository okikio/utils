{
	"name": "@okikio/format",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		"./csv": "./csv/mod.ts",
		"./csv/dialect": "./csv/dialect.ts",
		"./csv/encoding": "./csv/encoding.ts",
		"./csv/headers": "./csv/headers.ts",
		"./csv/options": "./csv/options.ts",
		"./csv/parse": "./csv/parse.ts",
		"./csv/stream": "./csv/stream.ts",
		"./csv/types": "./csv/types.ts",
		"./csv/write": "./csv/write.ts",
		"./csv/validate": "./csv/validate.ts",
		"./csv/source": "./csv/source.ts",
		"./sitemap": "./sitemap/mod.ts",
		".": "./mod.ts"
	},
	"imports": {
		"@std/csv": "jsr:@std/csv@^1.0.6",
		"#/": "./",
		"@std/xml": "jsr:@std/xml@^0.2.0"
	},
	"license": "MIT",
	"tasks": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member format",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	},
	"permissions": {
		"test": {
			"read": [
				"./csv/fixtures"
			]
		},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
