{
	"name": "@okikio/dispose",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		"./once": "./once.ts",
		".": "./mod.ts",
		"./polyfill": "./polyfill.ts",
		"./ponyfill": "./ponyfill.ts",
		"./run": "./run.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project dispose",
		"test": "mise run test -- --project dispose",
		"bench": "mise run bench -- --project dispose",
		"bench:check": "mise run bench -- --project dispose --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
