		"@okikio/dispose/ponyfill": {
			"module_doc": {
				"doc": "Own resources through direct imports without installing disposal globals.\n\nCall dispose() or await disposeAsync() in finally. The exported protocol keys reuse host\nsymbols or provide local fallback keys. Native using syntax requires host well-known symbols\nor the explicit polyfill; local keys alone cannot change the language's disposal protocol.",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport { AsyncDisposableStack } from '@okikio/dispose/ponyfill';\nconst owned = new AsyncDisposableStack();\nowned.defer(() => console.log('connection closed'));\nawait owned.disposeAsync();\n```"
					},
					{
						"kind": "module"
					}
				]
			},
