		"@okikio/dispose": {
			"module_doc": {
				"doc": "Dispose owned values in a predictable order while preserving both the operation failure and any cleanup failure. Hand-written finally blocks often skip later cleanup when one callback throws.\n\nImport the local constructors for library-owned lifetimes without changing globals. Use language-level using and await using when the engine supports the standard protocol. Import @okikio/dispose/polyfill explicitly if an application chooses global compatibility. Cleanup runs in reverse registration order even after failure, including thrown undefined. Register only owned resources.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport { AsyncDisposableStack } from '@okikio/dispose';\nconst closed: string[] = [];\nconst stack = new AsyncDisposableStack();\nstack.defer(() => { closed.push('connection'); });\nstack.defer(() => { closed.push('temporary file'); });\nawait stack.disposeAsync();\nconsole.log(closed.join(', '));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
