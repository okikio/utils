{
	"name": "@okikio/result",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		"./async": "./async.ts",
		"./failure": "./failure/mod.ts",
		"./failure/types": "./failure/types.ts",
		"./fault": "./fault/mod.ts",
		"./fault/types": "./fault/types.ts",
		".": "./mod.ts",
		"./failure/migrate": "./failure/migrate.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project result",
		"test": "mise run test -- --project result",
		"bench": "mise run bench -- --project result",
		"bench:check": "mise run bench -- --project result --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
