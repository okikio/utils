{
	"package": "@okikio/result",
	"packageVersion": "0.0.0",
	"rendererVersion": 2,
	"modules": {
		"@okikio/result": {
			"module_doc": {
				"doc": "Represent an expected success or failure as data and force call sites to choose a branch. Throwing for every missing value makes ordinary control flow indistinguishable from an unexpected provider fault.\n\nUse match() at a consumer that must handle both paths, or getOr()/getOrElse() for an intentional fallback. unwrap() turns a failure back into a thrown value when exception flow is appropriate. Result does not define a durable failure identity, retry policy or HTTP status; compose it with those packages when needed.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport * as result from '@okikio/result';\nconst found = result.ok('asset-1');\nconst missing = result.fail('missing');\nconsole.log(result.match(found, { ok: (id) => `loaded ${id}`, failure: (reason) => `failed ${reason}` }));\nconsole.log(result.getOr(missing as result.Result<string, string>, 'default'));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
