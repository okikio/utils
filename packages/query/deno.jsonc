{
	"name": "@okikio/query",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./definition": "./definition.ts",
		"./operators": "./operators.ts",
		"./types": "./types.ts",
		"./expression": "./expression.ts",
		"./pagination": "./page.ts",
		"./url": "./parameters.ts",
		"./cursor": "./cursor.ts",
		"./postgres": "./postgres.ts"
	},
	"imports": {
		"@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project query",
		"test": "mise run test -- --project query",
		"bench": "mise run bench -- --project query",
		"bench:check": "mise run bench -- --project query --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
