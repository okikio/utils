{
	"name": "@okikio/hash",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./digest": "./digest.ts",
		"./sync": "./sync.ts",
		"./stream": "./stream.ts",
		"./encoding": "./encoding.ts",
		"./random": "./random.ts",
		"./id": "./id.ts",
		"./uuid": "./uuid.ts",
		"./sha3": "./sha3.ts",
		"./blake": "./blake.ts",
		"./checksum": "./checksum.ts",
		"./hmac": "./hmac/mod.ts",
		"./hmac/sync": "./hmac/sync.ts"
	},
	"imports": {
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/uuid": "jsr:@std/uuid@^1.1.2"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project hash",
		"test": "mise run test -- --project hash",
		"bench": "mise run bench -- --project hash",
		"bench:check": "mise run bench -- --project hash --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
