{
	"name": "@okikio/hash",
	"version": "0.1.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**",
			"wasm/abi/**",
			"wasm/sha2/**",
			"wasm/sha3/**",
			"wasm/blake/**",
			"wasm/legacy/**",
			"wasm/national/**",
			"wasm/contest/**",
			"wasm/fsb/**",
			"wasm/mac/**",
			"wasm/fast/**",
			"wasm/checksum/**",
			"wasm/.cargo/**",
			"wasm/Cargo.toml",
			"wasm/Cargo.lock",
			"wasm/*.toml",
			"wasm/.gitignore"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./digest": "./digest.ts",
		"./sync": "./sync.ts",
		"./stream": "./stream.ts",
		"./encoding": "./encoding.ts",
		"./random": "./random.ts",
		"./id": "./id.ts",
		"./uuid": "./uuid.ts",
		"./sha3": "./sha3.ts",
		"./blake": "./blake.ts",
		"./checksum": "./checksum.ts",
		"./hmac": "./hmac/mod.ts",
		"./hmac/sync": "./hmac/sync.ts",
		"./sha2": "./sha2.ts",
		"./sha2/wasm": "./_wasm/entry/sha2.ts",
		"./sha3/wasm": "./_wasm/entry/sha3.ts",
		"./blake/wasm": "./_wasm/entry/blake.ts",
		"./legacy": "./legacy.ts",
		"./legacy/wasm": "./_wasm/entry/legacy.ts",
		"./national": "./national.ts",
		"./national/wasm": "./_wasm/entry/national.ts",
		"./contest": "./contest.ts",
		"./contest/wasm": "./_wasm/entry/contest.ts",
		"./fsb": "./fsb.ts",
		"./fsb/wasm": "./_wasm/entry/fsb.ts",
		"./mac": "./mac.ts",
		"./mac/wasm": "./_wasm/entry/mac.ts",
		"./fast": "./fast.ts",
		"./fast/wasm": "./_wasm/entry/fast.ts",
		"./checksum/wasm": "./_wasm/entry/checksum.ts",
		"./base64": "./base64.ts",
		"./hex": "./hex.ts"
	},
	"imports": {
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/uuid": "jsr:@std/uuid@^1.1.2"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project hash",
		"test": "mise run test -- --project hash",
		"bench": "mise run bench -- --project hash",
		"bench:check": "mise run bench -- --project hash --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
