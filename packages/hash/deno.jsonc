{
	"name": "@okikio/hash",
	"version": "0.1.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**",
			"wasm/abi/**",
			"wasm/sha2/**",
			"wasm/sha3/**",
			"wasm/blake/**",
			"wasm/legacy/**",
			"wasm/national/**",
			"wasm/contest/**",
			"wasm/fsb/**",
			"wasm/mac/**",
			"wasm/fast/**",
			"wasm/checksum/**",
			"wasm/.cargo/**",
			"wasm/Cargo.toml",
			"wasm/Cargo.lock",
			"wasm/*.toml",
			"wasm/.gitignore"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./digest": "./digest.ts",
		"./sync": "./sync.ts",
		"./stream": "./stream.ts",
		"./encoding": "./encoding.ts",
		"./base64": "./base64.ts",
		"./hex": "./hex.ts",
		"./random": "./random.ts",
		"./id": "./id.ts",
		"./uuid": "./uuid.ts",
		"./hmac": "./hmac/mod.ts",
		"./hmac/sync": "./hmac/sync.ts",
		"./sha2": "./sha2.ts",
		"./sha2/wasm": "./_entry/wasm/sha2.ts",
		"./sha2/packed": "./_entry/packed/sha2.ts",
		"./sha2/native": "./_entry/native/sha2.ts",
		"./sha2/portable": "./_entry/portable/sha2.ts",
		"./sha2/web": "./_entry/web/sha2.ts",
		"./sha3": "./sha3.ts",
		"./sha3/wasm": "./_entry/wasm/sha3.ts",
		"./sha3/packed": "./_entry/packed/sha3.ts",
		"./sha3/native": "./_entry/native/sha3.ts",
		"./sha3/portable": "./_entry/portable/sha3.ts",
		"./blake": "./blake.ts",
		"./blake/wasm": "./_entry/wasm/blake.ts",
		"./blake/packed": "./_entry/packed/blake.ts",
		"./blake/native": "./_entry/native/blake.ts",
		"./blake/portable": "./_entry/portable/blake.ts",
		"./legacy": "./legacy.ts",
		"./legacy/wasm": "./_entry/wasm/legacy.ts",
		"./legacy/packed": "./_entry/packed/legacy.ts",
		"./legacy/native": "./_entry/native/legacy.ts",
		"./legacy/portable": "./_entry/portable/legacy.ts",
		"./legacy/web": "./_entry/web/legacy.ts",
		"./national": "./national.ts",
		"./national/wasm": "./_entry/wasm/national.ts",
		"./national/packed": "./_entry/packed/national.ts",
		"./national/native": "./_entry/native/national.ts",
		"./contest": "./contest.ts",
		"./contest/wasm": "./_entry/wasm/contest.ts",
		"./contest/packed": "./_entry/packed/contest.ts",
		"./fsb": "./fsb.ts",
		"./fsb/wasm": "./_entry/wasm/fsb.ts",
		"./fsb/packed": "./_entry/packed/fsb.ts",
		"./mac": "./mac.ts",
		"./mac/wasm": "./_entry/wasm/mac.ts",
		"./mac/packed": "./_entry/packed/mac.ts",
		"./fast": "./fast.ts",
		"./fast/wasm": "./_entry/wasm/fast.ts",
		"./fast/packed": "./_entry/packed/fast.ts",
		"./checksum": "./checksum.ts",
		"./checksum/wasm": "./_entry/wasm/checksum.ts",
		"./checksum/packed": "./_entry/packed/checksum.ts",
		"./checksum/portable": "./_entry/portable/checksum.ts",
		"./wasm/sha2.wasm": "./_wasm/raw/sha2.wasm",
		"./wasm/sha3.wasm": "./_wasm/raw/sha3.wasm",
		"./wasm/blake.wasm": "./_wasm/raw/blake.wasm",
		"./wasm/legacy.wasm": "./_wasm/raw/legacy.wasm",
		"./wasm/national.wasm": "./_wasm/raw/national.wasm",
		"./wasm/contest.wasm": "./_wasm/raw/contest.wasm",
		"./wasm/fsb.wasm": "./_wasm/raw/fsb.wasm",
		"./wasm/mac.wasm": "./_wasm/raw/mac.wasm",
		"./wasm/fast.wasm": "./_wasm/raw/fast.wasm",
		"./wasm/fast-wide.wasm": "./_wasm/raw/fast-wide.wasm",
		"./wasm/checksum.wasm": "./_wasm/raw/checksum.wasm"
	},
	"imports": {
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/uuid": "jsr:@std/uuid@^1.1.2"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project hash",
		"test": "mise run test -- --project hash",
		"bench": "mise run bench -- --project hash",
		"bench:check": "mise run bench -- --project hash --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
