	"modules": {
		"@okikio/record": {
			"module_doc": {
				"doc": "Inspect plain data records without accidentally invoking hidden getters or trusting inherited configuration. Object.keys plus direct reads can execute accessors and silently ignore properties that validation never saw.\n\nValidate authored options before snapshotting them, then use typed keys and entries to retain exact key/value relationships. Use the ordinary Web or JavaScript API when data is already trusted and the stronger record contract adds no value. Record inspection does not recursively validate application values or make external objects immutable.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport * as record from '@okikio/record';\nconst options = { host: 'localhost', port: 4321 } as const;\nrecord.assert(options, 'server options');\nconsole.log(record.keys(options).join(','));\nconsole.log(record.entries(options).map(([key, value]) => `${key}=${value}`).join(' '));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
			"imports": [
				{
					"importedName": "Entry",
					"originalName": "Entry",
