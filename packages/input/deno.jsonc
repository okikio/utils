{
	"name": "@okikio/input",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./keys": "./keys.ts",
		"./gestures": "./gestures.ts",
		"./text": "./text.ts",
		"./forms": "./forms.ts",
		"./files": "./files.ts",
		"./clipboard": "./clipboard.ts",
		"./gamepad": "./gamepad.ts",
		"./feedback": "./feedback.ts",
		"./commands": "./commands.ts",
		"./pointer": "./pointer.ts",
		"./types": "./types.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project input",
		"test": "mise run test -- --project input",
		"bench": "mise run bench -- --project input",
		"bench:check": "mise run bench -- --project input --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
