{
	"name": "@okikio/input",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./keys": "./keys.ts",
		"./gestures": "./gestures.ts",
		"./text": "./text.ts",
		"./forms": "./forms.ts",
		"./files": "./files.ts",
		"./clipboard": "./clipboard.ts",
		"./gamepad": "./gamepad.ts",
		"./feedback": "./feedback.ts",
		"./commands": "./commands.ts",
		"./pointer": "./pointer.ts",
		"./types": "./types.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member input",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
