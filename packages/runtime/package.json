{
	"name": "@okikio/runtime",
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		"./deno": "./deno/mod.ts",
		"./deno/permissions": "./deno/permissions.ts",
		"./deno/types": "./deno/types.ts",
		"./deno/signals": "./deno/signals.ts",
		"./deno/file": "./deno/file.ts",
		"./deno/port": "./deno/port.ts",
		"./deno/proxy": "./deno/proxy.ts",
		"./deno/readiness": "./deno/readiness.ts",
		"./deno/health": "./deno/health.ts",
		"./deno/process": "./deno/process.ts",
		"./node/process": "./node/process.ts",
		"./deno/worker": "./deno/worker.ts",
		".": "./mod.ts",
		"./node/worker": "./node/worker.ts",
		"./bun/worker": "./bun/worker.ts",
		"./browser/worker": "./browser/worker.ts",
		"./inspect": "./inspect.ts",
		"./deno/inspect": "./deno/inspect.ts"
	},
	"dependencies": {
		"@okikio/context": "workspace:^1.0.0",
		"@std/path": "npm:@jsr/std__path@^1.1.6",
		"@okikio/streams": "workspace:^0.1.0",
		"@okikio/worker": "workspace:^1.0.0",
		"@okikio/dispose": "workspace:^0.1.0"
	},
	"devDependencies": {
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"@okikio/schema": "workspace:^1.0.0",
		"mitata": "^1.0.34",
		"@okikio/duration": "workspace:^0.1.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/runtime",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member runtime",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
