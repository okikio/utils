{
	"name": "@okikio/runtime",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		"./deno": "./deno/mod.ts",
		"./deno/permissions": "./deno/permissions.ts",
		"./deno/types": "./deno/types.ts",
		"./deno/signals": "./deno/signals.ts",
		"./deno/file": "./deno/file.ts",
		"./deno/port": "./deno/port.ts",
		"./deno/proxy": "./deno/proxy.ts",
		"./deno/readiness": "./deno/readiness.ts",
		"./deno/health": "./deno/health.ts",
		"./deno/process": "./deno/process.ts",
		"./node/process": "./node/process.ts",
		"./deno/worker": "./deno/worker.ts",
		".": "./mod.ts",
		"./node/worker": "./node/worker.ts",
		"./bun/worker": "./bun/worker.ts",
		"./browser/worker": "./browser/worker.ts",
		"./inspect": "./inspect.ts",
		"./deno/inspect": "./deno/inspect.ts"
	},
	"imports": {
		"@std/path": "jsr:@std/path@^1.1.6"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project runtime",
		"test": "mise run test -- --project runtime",
		"bench": "mise run bench -- --project runtime",
		"bench:check": "mise run bench -- --project runtime --check"
	},
	"permissions": {
		"test": {
			"read": true,
			"write": true,
			"net": true,
			"env": true,
			"sys": true,
			"run": [
				"deno"
			]
		},
		"bench": {
			"read": true,
			"write": true,
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts",
			"node/"
		]
	}
}
