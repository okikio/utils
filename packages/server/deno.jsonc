{
	"name": "@okikio/server",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./endpoint": "./endpoint/mod.ts",
		"./endpoint/definition": "./endpoint/definition.ts",
		"./endpoint/handler": "./endpoint/handler.ts",
		"./endpoint/openapi": "./endpoint/openapi.ts",
		"./endpoint/path": "./endpoint/path.ts",
		"./endpoint/types": "./endpoint/types.ts",
		"./gateway": "./gateway/mod.ts",
		"./gateway/definition": "./gateway/definition.ts",
		"./gateway/types": "./gateway/types.ts",
		"./http": "./http/mod.ts",
		"./http/router": "./http/router.ts",
		"./http/types": "./http/types.ts",
		"./middleware": "./middleware/mod.ts",
		"./middleware/types": "./middleware/types.ts",
		"./service": "./service/mod.ts",
		"./service/definition": "./service/definition.ts",
		"./service/resilience": "./service/resilience.ts",
		"./service/types": "./service/types.ts",
		"./gateway/artifact": "./gateway/artifact.ts",
		"./gateway/openapi": "./gateway/openapi.ts",
		"./service/route": "./service/route.ts",
		"./client": "./client.ts"
	},
	"imports": {
		"@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0",
		"@std/async": "jsr:@std/async@^1.5.0"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project server",
		"test": "mise run test -- --project server",
		"bench": "mise run bench -- --project server",
		"bench:check": "mise run bench -- --project server --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
