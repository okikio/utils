{
	"name": "@okikio/server",
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./endpoint": "./endpoint/mod.ts",
		"./endpoint/definition": "./endpoint/definition.ts",
		"./endpoint/handler": "./endpoint/handler.ts",
		"./endpoint/openapi": "./endpoint/openapi.ts",
		"./endpoint/path": "./endpoint/path.ts",
		"./endpoint/types": "./endpoint/types.ts",
		"./gateway": "./gateway/mod.ts",
		"./gateway/definition": "./gateway/definition.ts",
		"./gateway/types": "./gateway/types.ts",
		"./http": "./http/mod.ts",
		"./http/router": "./http/router.ts",
		"./http/types": "./http/types.ts",
		"./middleware": "./middleware/mod.ts",
		"./middleware/types": "./middleware/types.ts",
		"./service": "./service/mod.ts",
		"./service/definition": "./service/definition.ts",
		"./service/resilience": "./service/resilience.ts",
		"./service/types": "./service/types.ts",
		"./gateway/artifact": "./gateway/artifact.ts",
		"./gateway/openapi": "./gateway/openapi.ts",
		"./service/route": "./service/route.ts",
		"./client": "./client.ts"
	},
	"dependencies": {
		"@okikio/capability": "workspace:^1.0.0",
		"@okikio/collection": "workspace:^1.0.0",
		"@okikio/context": "workspace:^1.0.0",
		"@okikio/duration": "workspace:^0.1.0",
		"@okikio/env": "workspace:^1.0.0",
		"@okikio/http": "workspace:^1.0.0",
		"@okikio/query": "workspace:^1.0.0",
		"@okikio/result": "workspace:^1.0.0",
		"@okikio/schema": "workspace:^1.0.0",
		"@okikio/telemetry": "workspace:^0.1.0",
		"@okikio/workflow": "workspace:^1.0.0",
		"@standard-schema/spec": "^1.1.0",
		"@std/async": "npm:@jsr/std__async@^1.5.1"
	},
	"devDependencies": {
		"@okikio/authz": "workspace:^0.1.0",
		"@okikio/dispose": "workspace:^0.1.0",
		"@okikio/result": "workspace:^1.0.0",
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"mitata": "^1.0.34"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/server",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member server",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
