{
	"name": "@okikio/authz",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./permission": "./permission/mod.ts",
		"./permission/definition": "./permission/definition.ts",
		"./permission/types": "./permission/types.ts",
		"./role": "./role/mod.ts",
		"./role/types": "./role/types.ts",
		"./entitlement": "./entitlement/mod.ts",
		"./entitlement/types": "./entitlement/types.ts",
		"./entitlement/definition": "./entitlement/definition.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project authz",
		"test": "mise run test -- --project authz",
		"bench": "mise run bench -- --project authz",
		"bench:check": "mise run bench -- --project authz --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
