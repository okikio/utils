{
	"name": "@okikio/env",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./standard": "./standard.ts",
		"./valibot": "./valibot.ts",
		"./zod": "./zod.ts",
		"./types": "./types.ts",
		"./resolve": "./resolve.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project env",
		"test": "mise run test -- --project env",
		"bench": "mise run bench -- --project env",
		"bench:check": "mise run bench -- --project env --check"
	},
	"permissions": {
		"test": {
			"env": true
		},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
