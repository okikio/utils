{
	"name": "@okikio/env",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*_test.ts",
			"**/*.test.ts",
			"**/*_bench.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./standard": "./standard.ts",
		"./valibot": "./valibot.ts",
		"./zod": "./zod.ts"
	},
	"imports": {
		"@standard-schema/spec": "npm:@standard-schema/spec@^1.1.0",
		"fast-check": "npm:fast-check@^4.9.0",
		"mitata": "npm:mitata@^1.0.34",
		"valibot": "npm:valibot@^1.4.2",
		"zod": "npm:zod@^4.5.4"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts standard.ts valibot.ts zod.ts",
		"test": "deno test -P=test",
		"bench": "deno bench"
	},
	"permissions": {
		"test": {
			"env": true
		}
	},
	"fmt": {
		"lineWidth": 120,
		"semiColons": false,
		"singleQuote": true,
		"useTabs": true,
		"indentWidth": 2
	},
	"license": "MIT"
}
