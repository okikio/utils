{
	"name": "@okikio/env",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./standard": "./standard.ts",
		"./valibot": "./valibot.ts",
		"./zod": "./zod.ts",
		"./types": "./types.ts",
		"./resolve": "./resolve.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member env",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	},
	"permissions": {
		"test": {
			"env": true
		},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
