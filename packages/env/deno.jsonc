{
	"name": "@okikio/env",
	"version": "0.1.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./standard": "./standard.ts",
		"./valibot": "./valibot.ts",
		"./zod": "./zod.ts",
		"./types": "./types.ts"
	},
	"imports": {
		"@standard-schema/spec": "npm:@standard-schema/spec@^1.1.0",
		"fast-check": "npm:fast-check@^4.9.0",
		"mitata": "npm:mitata@^1.0.34",
		"valibot": "npm:valibot@^1.4.2",
		"zod": "npm:zod@^4.5.4"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts standard.ts valibot.ts zod.ts",
		"test": "deno test -P=test",
		"bench": "deno run --v8-flags=--expose-gc -P=bench mod.bench.ts"
	},
	"permissions": {
		"test": {
			"env": true
		},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR",
				"CI"
			],
			"sys": [
				"cpus"
			]
		}
	},
	"license": "MIT"
}
