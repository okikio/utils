		"@okikio/robots": {
			"module_doc": {
				"doc": "Apply user-agent-specific robots rules with overlap and wildcard semantics. Collecting every Disallow line mixes unrelated groups and cannot tell whether a more specific Allow rule wins.\n\nParse once and check many URLs, then collect declared sitemaps for discovery. Unknown extension records remain available for higher-level policy. The parser performs no fetch and does not decide HTTP status, caching or authority rules. The application owns acquisition limits and whether a failed robots fetch should allow or deny crawling.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport * as robots from '@okikio/robots';\nconst policy = robots.parse(`User-agent: *\nDisallow: /private/\nAllow: /private/pricing\n`);\nconsole.log(robots.match(policy, { userAgent: 'ResearchBot', url: 'https://example.com/private/report' }));\nconsole.log(robots.match(policy, { userAgent: 'ResearchBot', url: 'https://example.com/private/pricing' }));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
