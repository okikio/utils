{
	"name": "@okikio/streams",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./bytes": "./bytes.ts",
		"./json": "./json.ts",
		"./reader": "./reader.ts",
		"./text": "./text.ts",
		"./frame": "./frame.ts",
		"./events": "./events.ts"
	},
	"imports": {
		"@okikio/observables": "jsr:@okikio/observables@1.4.0"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project streams",
		"test": "mise run test -- --project streams",
		"bench": "mise run bench -- --project streams",
		"bench:check": "mise run bench -- --project streams --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
