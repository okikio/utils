{
	"name": "@okikio/duration",
	"version": "0.1.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		"./arithmetic": "./arithmetic.ts",
		"./format": "./format.ts",
		"./units": "./units.ts",
		"./conversion": "./conversion.ts",
		"./instant": "./instant.ts",
		".": "./mod.ts",
		"./types": "./types.ts",
		"./temporal": "./temporal.ts",
		"./polyfill": "./polyfill.ts"
	},
	"imports": {
		"temporal-polyfill/full/implementation": "npm:temporal-polyfill@1.0.5/full/implementation"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project duration",
		"test": "mise run test -- --project duration",
		"bench": "mise run bench -- --project duration",
		"bench:check": "mise run bench -- --project duration --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
