{
	"name": "@okikio/duration",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": [
		"./polyfill.ts"
	],
	"license": "MIT",
	"exports": {
		"./arithmetic": "./arithmetic.ts",
		"./format": "./format.ts",
		"./units": "./units.ts",
		"./conversion": "./conversion.ts",
		"./instant": "./instant.ts",
		".": "./mod.ts",
		"./types": "./types.ts",
		"./temporal": "./temporal.ts",
		"./polyfill": "./polyfill.ts"
	},
	"dependencies": {
		"temporal-polyfill": "1.0.8"
	},
	"devDependencies": {
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"mitata": "^1.0.34"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/duration",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member duration",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
