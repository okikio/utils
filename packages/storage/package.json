{
	"name": "@okikio/storage",
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./workflow/postgres": "./workflow/postgres/mod.ts",
		"./queue": "./queue/mod.ts",
		"./queue/postgres": "./queue/postgres.ts",
		"./workflow": "./workflow/mod.ts",
		"./state": "./state/mod.ts",
		"./state/web": "./state/web.ts",
		"./state/postgres": "./state/postgres.ts",
		"./session/postgres": "./session/postgres.ts",
		"./outbox/postgres": "./outbox/postgres.ts",
		"./outbox/effect": "./outbox/effect.ts"
	},
	"dependencies": {
		"@okikio/capability": "workspace:^1.0.0",
		"@okikio/collection": "workspace:^1.0.0",
		"@okikio/context": "workspace:^1.0.0",
		"@okikio/dispose": "workspace:^0.1.0",
		"@okikio/duration": "workspace:^0.1.0",
		"@okikio/result": "workspace:^1.0.0",
		"@okikio/scheduler": "workspace:^1.0.0",
		"@okikio/schema": "workspace:^1.0.0",
		"@okikio/sql": "workspace:^0.1.0",
		"@okikio/telemetry": "workspace:^0.1.0",
		"@okikio/workflow": "workspace:^1.0.0",
		"@okikio/observables": "^1.4.0",
		"postgres": "4.1.1"
	},
	"devDependencies": {
		"@standard-schema/spec": "^1.1.0",
		"mitata": "^1.0.34",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/storage",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member storage",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
