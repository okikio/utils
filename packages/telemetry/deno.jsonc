{
	"name": "@okikio/telemetry",
	"version": "0.1.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./logtape": "./logtape.ts",
		"./otel": "./otel.ts",
		"./server": "./server.ts",
		"./lifecycle": "./lifecycle.ts",
		"./json": "./json.ts",
		"./node": "./node.ts",
		"./instrument": "./instrument.ts",
		"./otel/instrument": "./otel/instrument.ts",
		"./observe": "./observe.ts",
		"./events": "./events.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project telemetry",
		"test": "mise run test -- --project telemetry",
		"bench": "mise run bench -- --project telemetry",
		"bench:check": "mise run bench -- --project telemetry --check"
	},
	"permissions": {
		"test": {
			"env": true,
			"net": [
				"127.0.0.1"
			]
		},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
