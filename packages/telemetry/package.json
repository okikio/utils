{
	"name": "@okikio/telemetry",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./logtape": "./logtape.ts",
		"./otel": "./otel.ts",
		"./server": "./server.ts",
		"./lifecycle": "./lifecycle.ts",
		"./json": "./json.ts",
		"./node": "./node.ts",
		"./instrument": "./instrument.ts",
		"./otel/instrument": "./otel/instrument.ts",
		"./observe": "./observe.ts",
		"./events": "./events.ts"
	},
	"dependencies": {
		"@okikio/collection": "workspace:^1.0.0",
		"@okikio/result": "workspace:^1.0.0",
		"@okikio/schema": "workspace:^1.0.0",
		"@okikio/observables": "^1.4.0"
	},
	"devDependencies": {
		"@okikio/pool": "workspace:^0.1.0",
		"@okikio/scheduler": "workspace:^1.0.0",
		"@okikio/server": "workspace:^1.0.0",
		"@okikio/worker": "workspace:^1.0.0",
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"mitata": "^1.0.34"
	},
	"optionalDependencies": {
		"@logtape/logtape": "2.4.2",
		"@logtape/otel": "2.4.2",
		"@opentelemetry/api": "1.10.0",
		"@opentelemetry/context-async-hooks": "3.1.1",
		"@opentelemetry/core": "3.1.1",
		"@opentelemetry/exporter-logs-otlp-http": "0.301.2",
		"@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
		"@opentelemetry/exporter-trace-otlp-http": "0.301.2",
		"@opentelemetry/resources": "3.1.1",
		"@opentelemetry/sdk-logs": "3.1.1",
		"@opentelemetry/sdk-metrics": "3.1.1",
		"@opentelemetry/sdk-trace": "3.1.1"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/telemetry",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member telemetry",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
