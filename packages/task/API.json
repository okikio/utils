		"@okikio/task": {
			"module_doc": {
				"doc": "Control one process-local operation with cooperative pause, cancellation and joined cleanup. A Promise alone cannot request a pause or communicate whether cancellation and resource disposal have finished.\n\nAdd checkpoints between indivisible provider calls so pause requests have a place to take effect. Pass the context signal into I/O for cancellation. done owns the terminal value and cleanup failure; disposal joins pending cleanup. A task is one local lifetime, while a workflow can create many tasks during retries or replay. Do not use a task status as evidence of durable external acceptance.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport '@okikio/duration/polyfill';\nimport '@okikio/dispose/polyfill';\nimport * as task from '@okikio/task';\nconst cleanup: string[] = [];\nawait using work = task.start(async (ctx) => {\n  ctx.defer(() => { cleanup.push('released'); });\n  await ctx.checkpoint();\n  return 42;\n}, { id: 'local-operation' });\nconsole.log(await work.done, work.status, cleanup.join(','));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
			"imports": [
				{
					"importedName": "context",
					"src": "./packages/context/mod.ts",
