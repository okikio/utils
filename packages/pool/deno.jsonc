{
	"name": "@okikio/pool",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts"
	},
	"imports": {
		"@okikio/observables": "jsr:@okikio/observables@1.4.0"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project pool",
		"test": "mise run test -- --project pool",
		"bench": "mise run bench -- --project pool",
		"bench:check": "mise run bench -- --project pool --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
