{
	"name": "@okikio/hono",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts"
	},
	"imports": {
		"hono": "npm:hono@^4.13.5"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts",
		"test": "deno test -P=test",
		"bench": "deno run --v8-flags=--expose-gc -P=bench mod.bench.ts"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR",
				"CI"
			],
			"sys": [
				"cpus"
			]
		}
	},
	"license": "MIT"
}
