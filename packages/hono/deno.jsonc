{
	"name": "@okikio/hono",
	"version": "0.1.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project hono",
		"test": "mise run test -- --project hono",
		"bench": "mise run bench -- --project hono",
		"bench:check": "mise run bench -- --project hono --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
