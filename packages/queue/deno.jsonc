{
	"name": "@okikio/queue",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./fifo": "./fifo.ts"
	},
	"imports": {
		"@okikio/observables": "jsr:@okikio/observables@1.4.0",
		"mitata": "npm:mitata@^1.0.34"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts",
		"test": "deno test -P=test",
		"bench": "deno run -P=bench mod.bench.ts"
	},
	"permissions": {
		"test": {},
		"bench": {}
	},
	"license": "MIT"
}
