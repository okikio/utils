{
	"name": "@okikio/capability",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		"./effect": "./effect/mod.ts",
		"./effect/types": "./effect/types.ts",
		"./effect/observe": "./effect/observe.ts",
		"./effect/meter": "./effect/meter/mod.ts",
		"./effect/meter/types": "./effect/meter/types.ts",
		"./effect/meter/schema": "./effect/meter/schema.ts",
		"./requirement": "./requirement/mod.ts",
		"./requirement/types": "./requirement/types.ts",
		"./requirement/definition": "./requirement/definition.ts",
		"./resilience": "./resilience/mod.ts",
		"./resilience/types": "./resilience/types.ts",
		"./resilience/poll": "./resilience/poll.ts",
		"./resource": "./resource/mod.ts",
		"./resource/types": "./resource/types.ts",
		"./execution": "./execution.ts",
		".": "./mod.ts",
		"./resilience/attempt": "./resilience/attempt.ts",
		"./resource/session": "./resource/session/mod.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member capability",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
