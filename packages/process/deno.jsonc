{
	"name": "@okikio/process",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*_test.ts",
			"**/*.test.ts",
			"**/*_bench.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./deno": "./deno.ts",
		"./node": "./node.ts",
		"./channel": "./channel/mod.ts",
		"./channel/types": "./channel/types.ts"
	},
	"imports": {
		"@okikio/observables": "jsr:@okikio/observables@1.4.0",
		"@std/expect": "jsr:@std/expect@^1.0.20"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts deno.ts node.ts channel/mod.ts",
		"test": "deno test -P=test"
	},
	"permissions": {
		"test": {
			"run": [
				"deno",
				"node"
			]
		}
	},
	"license": "MIT"
}
