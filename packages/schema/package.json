{
	"name": "@okikio/schema",
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./time": "./time.ts",
		"./zod": "./zod.ts",
		"./codec": "./codec/mod.ts",
		"./codec/types": "./codec/types.ts"
	},
	"dependencies": {
		"@okikio/collection": "workspace:^1.0.0",
		"@okikio/duration": "workspace:^0.1.0",
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@okikio/hono": "workspace:^0.1.0",
		"@okikio/http": "workspace:^1.0.0",
		"@okikio/query": "workspace:^1.0.0",
		"@okikio/server": "workspace:^1.0.0",
		"@sinclair/typebox": "0.34.52",
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"mitata": "^1.0.34",
		"typebox": "1.4.7",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"zod": "^4.4.3"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/schema",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member schema",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
