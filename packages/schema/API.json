		"@okikio/schema": {
			"module_doc": {
				"doc": "Use one Standard Schema validation call across validator libraries. Reading a validator-specific result shape in every utility otherwise forces consumers to use the same schema engine.\n\nStart with parse() when invalid input should throw, then use result-oriented validation where a caller needs structured issues. Keep coercion in the schema that owns the meaning. JSON Schema projection is a separate capability and can fail for values that have no faithful wire representation. Import a validator adapter explicitly; the generic validation core does not silently choose one.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport * as schema from '@okikio/schema';\nimport { z } from 'zod';\nconst PortSchema = z.coerce.number().int().min(1).max(65535);\nconsole.log(await schema.parse(PortSchema, '8787'));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
