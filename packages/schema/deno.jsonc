{
	"name": "@okikio/schema",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*_test.ts",
			"**/*.test.ts",
			"**/*_bench.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./zod": "./zod.ts"
	},
	"imports": {
		"@standard-schema/spec": "npm:@standard-schema/spec@1.1.0",
		"@std/expect": "jsr:@std/expect@^1.0.20",
		"zod": "jsr:@zod/zod@^4.4.3"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts",
		"test": "deno test -P=test"
	},
	"permissions": {
		"test": {}
	},
	"license": "MIT"
}
