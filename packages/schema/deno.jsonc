{
	"name": "@okikio/schema",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./time": "./time.ts",
		"./zod": "./zod.ts",
		"./codec": "./codec/mod.ts",
		"./codec/types": "./codec/types.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project schema",
		"test": "mise run test -- --project schema",
		"bench": "mise run bench -- --project schema",
		"bench:check": "mise run bench -- --project schema --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
