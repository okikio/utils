{
	"name": "@okikio/collection",
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		"./iterable": "./iterable.ts",
		"./catalog": "./catalog/mod.ts",
		"./catalog/types": "./catalog/types.ts",
		"./record": "./record/mod.ts",
		"./record/types": "./record/types.ts",
		"./record/json": "./record/json.ts",
		"./record/change": "./record/change.ts",
		".": "./mod.ts"
	},
	"devDependencies": {
		"@okikio/schema": "workspace:^1.0.0",
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"fast-check": "^4.11.0",
		"mitata": "^1.0.34"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/collection",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member collection",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
