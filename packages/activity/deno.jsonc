{
	"name": "@okikio/activity",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./engine": "./engine.ts",
		"./local": "./local.ts",
		"./process": "./process.ts",
		"./types": "./types.ts",
		"./worker": "./worker.ts",
		"./selection": "./selection.ts",
		"./http": "./http.ts",
		"./http/duplex": "./http/duplex.ts"
	},
	"imports": {
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project activity",
		"test": "mise run test -- --project activity",
		"bench": "mise run bench -- --project activity",
		"bench:check": "mise run bench -- --project activity --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
