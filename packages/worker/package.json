{
	"name": "@okikio/worker",
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		"./process": "./process/mod.ts",
		"./process/types": "./process/types.ts",
		"./process/channel": "./process/channel/mod.ts",
		"./process/channel/types": "./process/channel/types.ts",
		"./thread": "./thread/mod.ts",
		"./thread/types": "./thread/types.ts",
		".": "./mod.ts",
		"./protocol": "./protocol.ts",
		"./supervisor": "./supervisor.ts",
		"./stream": "./stream/mod.ts",
		"./stream/types": "./stream/types.ts"
	},
	"dependencies": {
		"@okikio/observables": "^1.4.0",
		"@okikio/context": "workspace:^1.0.0",
		"@okikio/result": "workspace:^1.0.0",
		"@okikio/schema": "workspace:^1.0.0",
		"@okikio/telemetry": "workspace:^0.1.0",
		"@okikio/dispose": "workspace:^0.1.0"
	},
	"devDependencies": {
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"@standard-schema/spec": "^1.1.0",
		"mitata": "^1.0.34",
		"@okikio/runtime": "workspace:^1.0.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/worker",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member worker",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
