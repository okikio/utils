{
	"name": "@okikio/worker",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*_test.ts",
			"**/*.test.ts",
			"**/*_bench.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./deno": "./deno.ts"
	},
	"imports": {
		"@okikio/observables": "jsr:@okikio/observables@1.4.0",
		"@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts deno.ts",
		"test": "deno test -P=test"
	},
	"permissions": {
		"test": {}
	},
	"license": "MIT"
}
