{
	"name": "@okikio/worker",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		"./process": "./process/mod.ts",
		"./process/types": "./process/types.ts",
		"./process/channel": "./process/channel/mod.ts",
		"./process/channel/types": "./process/channel/types.ts",
		"./thread": "./thread/mod.ts",
		"./thread/types": "./thread/types.ts",
		".": "./mod.ts",
		"./protocol": "./protocol.ts",
		"./supervisor": "./supervisor.ts",
		"./stream": "./stream/mod.ts",
		"./stream/types": "./stream/types.ts"
	},
	"imports": {
		"@okikio/observables": "jsr:@okikio/observables@1.4.0",
		"@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project worker",
		"test": "mise run test -- --project worker",
		"bench": "mise run bench -- --project worker",
		"bench:check": "mise run bench -- --project worker --check"
	},
	"permissions": {
		"test": {
			"run": true,
			"read": true
		},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts",
			"process/node.test.ts"
		]
	}
}
