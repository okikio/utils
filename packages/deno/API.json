		"@okikio/deno": {
			"module_doc": {
				"doc": "Express Deno permission grants as data and convert them to correctly escaped CLI arguments. Hand-built flags can accidentally grant a whole directory or mishandle paths containing commas.\n\nUse permission arguments when launching a child, file helpers for bounded filesystem operations, and port helpers when a host needs a listener. These are explicit Deno adapters; portable algorithms belong in the other packages. Grant only the capabilities your executable needs. Building an argument list does not grant the current process a permission.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport * as permissions from '@okikio/deno/permissions';\nconst args = permissions.args({ read: ['/srv/input'], run: ['ffmpeg'] });\nconsole.log(JSON.stringify(args));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
