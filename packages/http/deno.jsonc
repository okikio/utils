{
	"name": "@okikio/http",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./cookie": "./cookie/mod.ts",
		"./problem": "./problem/mod.ts",
		"./problem/testing": "./problem/testing/mod.ts",
		"./request": "./request/mod.ts",
		"./webhook": "./webhook/mod.ts",
		"./webhook/standard": "./webhook/standard.ts",
		"./response": "./response/mod.ts",
		"./response/body": "./response/body.ts",
		"./response/types": "./response/types.ts",
		"./response/headers": "./response/headers.ts",
		"./response/completion": "./response/completion.ts",
		"./response/http": "./response/http.ts",
		"./response/status": "./response/status.ts",
		"./problem/types": "./problem/types.ts",
		"./request/types": "./request/types.ts",
		"./headers": "./headers.ts",
		"./retry": "./retry.ts",
		"./signature": "./signature/mod.ts",
		"./events": "./events.ts"
	},
	"imports": {
		"@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0",
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/http": "jsr:@std/http@^1.1.3"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project http",
		"test": "mise run test -- --project http",
		"bench": "mise run bench -- --project http",
		"bench:check": "mise run bench -- --project http --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
