{
	"name": "@okikio/http",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*_test.ts",
			"**/*.test.ts",
			"**/*_bench.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./cookie": "./cookie/mod.ts",
		"./problem": "./problem/mod.ts",
		"./problem/testing": "./problem/testing/mod.ts",
		"./request": "./request/mod.ts",
		"./response": "./response/mod.ts",
		"./response/body": "./response/body.ts",
		"./response/types": "./response/types.ts",
		"./response/headers": "./response/headers.ts",
		"./response/completion": "./response/completion.ts",
		"./response/http": "./response/http.ts",
		"./response/status": "./response/status.ts"
	},
	"imports": {
		"@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0",
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/http": "jsr:@std/http@^1.1.3",
		"fast-check": "npm:fast-check@^4.9.0"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts cookie/mod.ts request/mod.ts problem/mod.ts response/mod.ts",
		"test": "deno test -P=test"
	},
	"permissions": {
		"test": {}
	},
	"license": "MIT"
}
