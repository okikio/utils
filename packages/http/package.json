{
	"name": "@okikio/http",
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./cookie": "./cookie/mod.ts",
		"./client": "./client/mod.ts",
		"./problem": "./problem/mod.ts",
		"./problem/testing": "./problem/testing/mod.ts",
		"./request": "./request/mod.ts",
		"./webhook": "./webhook/mod.ts",
		"./webhook/standard": "./webhook/standard.ts",
		"./response": "./response/mod.ts",
		"./response/body": "./response/body.ts",
		"./response/types": "./response/types.ts",
		"./response/headers": "./response/headers.ts",
		"./response/completion": "./response/completion.ts",
		"./response/http": "./response/http.ts",
		"./response/status": "./response/status.ts",
		"./problem/types": "./problem/types.ts",
		"./request/types": "./request/types.ts",
		"./headers": "./headers.ts",
		"./retry": "./retry.ts",
		"./signature": "./signature/mod.ts",
		"./events": "./events.ts"
	},
	"dependencies": {
		"@okikio/collection": "workspace:^1.0.0",
		"@okikio/dispose": "workspace:^0.1.0",
		"@okikio/duration": "workspace:^0.1.0",
		"@okikio/hash": "workspace:^0.1.0",
		"@okikio/schema": "workspace:^1.0.0",
		"@okikio/streams": "workspace:^0.1.0",
		"@standard-schema/spec": "^1.1.0",
		"@std/encoding": "npm:@jsr/std__encoding@^1.0.11",
		"@std/http": "npm:@jsr/std__http@^1.1.4"
	},
	"devDependencies": {
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"fast-check": "^4.11.0",
		"mitata": "^1.0.34"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/http",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member http",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
