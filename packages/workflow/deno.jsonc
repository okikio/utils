{
	"name": "@okikio/workflow",
	"version": "1.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"**/fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./dispatch": "./dispatch.ts",
		"./history": "./history.ts",
		"./types": "./types.ts",
		"./execution": "./execution.ts",
		"./testing": "./testing.ts",
		"./replay": "./replay/check.ts"
	},
	"imports": {
		"@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0",
		"@std/encoding": "jsr:@std/encoding@^1.0.11"
	},
	"license": "MIT",
	"tasks": {
		"check": "mise run check -- --project workflow",
		"test": "mise run test -- --project workflow",
		"bench": "mise run bench -- --project workflow",
		"bench:check": "mise run bench -- --project workflow --check"
	},
	"permissions": {
		"test": {},
		"bench": {
			"env": [
				"NODE_DISABLE_COLORS",
				"NO_COLOR",
				"FORCE_COLOR"
			]
		}
	},
	"test": {
		"exclude": [
			"**/*.types.test.ts",
			"**/types.test.ts"
		]
	}
}
