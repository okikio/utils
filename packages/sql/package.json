{
	"name": "@okikio/sql",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./postgres": "./postgres/mod.ts",
		"./postgres/adopt": "./postgres/adopt.ts",
		"./postgres/cockroach": "./postgres/cockroach.ts",
		"./postgres/drizzle": "./postgres/drizzle/mod.ts",
		"./postgres/kysely": "./postgres/kysely.ts",
		"./postgres/pg": "./postgres/pg.ts",
		"./postgres/postgresjs": "./postgres/postgresjs.ts"
	},
	"dependencies": {
		"@okikio/duration": "workspace:^0.1.0"
	},
	"devDependencies": {
		"@std/expect": "npm:@jsr/std__expect@^1.0.20"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/sql",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member sql",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
