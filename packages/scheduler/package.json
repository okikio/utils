{
	"name": "@okikio/scheduler",
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"exports": {
		"./capacity": "./capacity/mod.ts",
		"./capacity/standard": "./capacity/standard.ts",
		"./capacity/types": "./capacity/types.ts",
		"./concurrency": "./concurrency/mod.ts",
		"./concurrency/bounded": "./concurrency/bounded.ts",
		"./concurrency/channel": "./concurrency/channel.ts",
		"./queue": "./queue/mod.ts",
		"./queue/types": "./queue/types.ts",
		"./queue/fifo": "./queue/fifo.ts",
		"./queue/policy": "./queue/policy.ts",
		".": "./mod.ts"
	},
	"dependencies": {
		"@okikio/collection": "workspace:^1.0.0",
		"@okikio/context": "workspace:^1.0.0",
		"@okikio/duration": "workspace:^0.1.0",
		"@okikio/result": "workspace:^1.0.0",
		"@okikio/schema": "workspace:^1.0.0",
		"@okikio/telemetry": "workspace:^0.1.0",
		"@okikio/observables": "^1.4.0",
		"@standard-schema/spec": "^1.1.0",
		"@std/async": "npm:@jsr/std__async@^1.5.1"
	},
	"devDependencies": {
		"@std/expect": "npm:@jsr/std__expect@^1.0.20",
		"mitata": "^1.0.34",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"access": "public",
		"directory": "../../.tmp/artifacts/npm/scheduler",
		"linkDirectory": false
	},
	"scripts": {
		"check": "deno check --frozen .",
		"test": "node ../../tools/testing/run.ts deno .",
		"test:deno": "node ../../tools/testing/run.ts deno .",
		"test:node": "node ../../tools/testing/run.ts node .",
		"test:bun": "node ../../tools/testing/run.ts bun .",
		"build": "node ../../tools/packages/npm.ts member scheduler",
		"bench": "deno run --frozen -A ../../tools/bench/measure.ts --suite=packages",
		"bench:check": "deno run --frozen --allow-read --allow-env=__MINIMATCH_TESTING_PLATFORM__ --allow-run ../../tools/bench/check.ts --check --suite=packages"
	}
}
