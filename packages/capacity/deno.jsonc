{
	"name": "@okikio/capacity",
	"version": "0.0.0",
	"publish": {
		"exclude": [
			"**/*.test.ts",
			"**/*.bench.ts",
			"fixtures/**"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./standard": "./standard.ts",
		"./types": "./types.ts"
	},
	"imports": {
		"@standard-schema/spec": "npm:@standard-schema/spec@^1.1.0",
		"zod": "npm:zod@^4.5.4"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check . && deno doc --lint mod.ts standard.ts",
		"test": "deno test -P=test"
	},
	"permissions": {
		"test": {}
	},
	"license": "MIT"
}
