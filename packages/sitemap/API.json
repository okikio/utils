		"@okikio/sitemap": {
			"module_doc": {
				"doc": "Read sitemap, feed and text discovery sources through one record model. Looking for every XML loc element loses source kind, alternate links and malformed-document evidence.\n\nUse locations() when only URLs matter, parse() when provenance and metadata matter, and parseStream() for bounded incremental ingestion. Choose standards or lenient policy explicitly for imperfect sources and retain problems for diagnostics. The utility does not fetch nested sitemap indexes or choose crawl priority. The acquiring application owns network, byte and source-count budgets.\n",
				"tags": [
					{
						"kind": "example",
						"doc": "```ts\nimport * as sitemap from '@okikio/sitemap';\nconst text = '<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://example.com/guide</loc></url></urlset>';\nconsole.log(JSON.stringify(sitemap.locations({ url: 'https://example.com/sitemap.xml', contentType: 'application/xml', text })));\n```\n"
					},
					{
						"kind": "module"
					}
				]
			},
